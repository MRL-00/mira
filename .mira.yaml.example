# Mira configuration file
# Copy this to .mira.yaml in your repository root

llm:
  # Provider: "openai" (default, any OpenAI-compatible endpoint) or "bedrock" (AWS)
  # provider: "openai"

  # Model identifier (any LiteLLM-supported model)
  model: "openai/gpt-4o"
  # Fallback model if primary fails
  fallback_model: "openai/gpt-4o-mini"
  temperature: 0.2
  max_tokens: 4096

  # Optional dedicated model for grading linked-ticket acceptance criteria
  # (one small call per review). It has to reason about what a diff does and
  # does not prove, so a fast/no-reasoning tier tends to hallucinate "unmet".
  # Falls back to review_model, then model.
  # ticket_model: "anthropic/claude-sonnet-4-6"
  # ticket_reasoning_effort: "medium"

  # ── AWS Bedrock configuration (uncomment to use) ──
  # provider: "bedrock"
  # model: "us.anthropic.claude-sonnet-4-6-v1:0"
  # fallback_model: "us.anthropic.claude-haiku-4-5-v1:0"
  # region: "us-east-1"
  # aws_profile: "my-profile"  # optional, uses default AWS credential chain if omitted

  # Retry and timeout configuration (defaults: 3 attempts, 120s timeout, 2-30s backoff)
  # Increase for flex-tier models or proxied endpoints under load
  # max_retries: 3
  # request_timeout: 120
  # retry_min_wait: 2
  # retry_max_wait: 30

filter:
  # Minimum confidence threshold (0.0 - 1.0)
  confidence_threshold: 0.7
  # Maximum number of comments to post
  max_comments: 5
  # Minimum severity level: blocker, warning, suggestion, nitpick
  min_severity: "nitpick"
  # Glob patterns for files to exclude
  exclude_patterns:
    - "*.lock"
    - "*.lockb"
    - "package-lock.json"
    - "yarn.lock"
    - "pnpm-lock.yaml"
    - "*.min.js"
    - "*.min.css"
    - "*.map"
    - "*.svg"
    - "*.png"
    - "*.jpg"
    - "*.gif"
  # Auto-review only PRs from these authors (empty = review all)
  # allowed_authors:
  #   - alice
  # Never auto-review PRs from these authors (takes precedence over allowed)
  # blocked_authors:
  #   - app/renovate
  #   - app/dependabot
  # Skip deleted files
  exclude_deleted: true
  # Maximum number of files to review
  max_files: 50

review:
  # Lines of context around hunks
  context_lines: 3
  # Maximum diff size in characters
  max_diff_size: 50000
  # Only flag critical problems/bugs (false = also suggest improvements)
  focus_only_on_problems: false
  # Include a summary comment
  include_summary: true
  # Generate a PR walkthrough comment (top-level summary)
  walkthrough: true
  # Include a Mermaid flow diagram in the walkthrough
  walkthrough_sequence_diagram: true
  # Character budget for the diff excerpts fed to the walkthrough so change
  # descriptions are grounded in the actual code (0 = metadata only)
  walkthrough_diff_budget: 40000
  # Submit the review as "Request changes" (blocking merge) when the verdict is
  # Request changes, i.e. a code blocker. Linked-ticket criteria Mira grades
  # as unmet are advisory ("Needs review") and never request changes on their
  # own. Set false to always post a plain comment.
  request_changes_on_blocker: true
  # Publish a GitHub check run for each review so Mira shows up in the PR's
  # checks list and can be required by branch protection. Needs the GitHub
  # App's "Checks: read and write" permission.
  check_run: true
  check_name: "Mira Review"

linear:
  # Link Linear issues referenced in the PR title/description/branch and give
  # the reviewer the ticket's intent. Requires MIRA_LINEAR_TOKEN in the
  # environment; without it the feature is silently off.
  enabled: true
  # Restrict lookups to these team keys (empty = any ABC-123-shaped token)
  # team_keys:
  #   - ENG
  # Render a walkthrough note when a PR references no issue at all
  require_issue: false
